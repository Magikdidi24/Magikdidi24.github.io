---
/*
  The panel of the keyboard: the skills and the languages of site.ts. Each
  group has the colour of its keys in the room.
*/
import Panel from './Panel.astro';
import { keycaps, spoken, stops } from '../../data/room';
import { languages, skills } from '../../data/site';
import { PALETTE } from '../../room/voxel/palette';

const stop = stops.find(({ id }) => id === 'skills')!;
const tint = (group: string) => `--tint: ${PALETTE[keycaps.find((cap) => cap.group === group)!.color]}`;
/* As in the text version: beside the spoken languages, the group "Languages" is named in full. */
const named = (group: string) => (group === 'Languages' ? 'Programming languages' : group);
---
<Panel id={stop.id} title={stop.label}>
  <p>Each lit key of the keyboard carries one of these.</p>
  <dl>
    {skills.map(({ group, items }) => (
      <div>
        <dt><span class="key" style={tint(group)} aria-hidden="true"></span>{named(group)}</dt>
        <dd>{items.join(', ')}</dd>
      </div>
    ))}
    <div>
      <dt><span class="key" style={tint(spoken.group)} aria-hidden="true"></span>{spoken.group}</dt>
      {languages.map(({ name, level }) => <dd>{name}: {level}</dd>)}
    </div>
  </dl>
</Panel>

<style>
  dl {
    margin: 0;
  }

  div + div {
    margin-top: var(--space-4);
  }

  dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* A keycap, in the colour of the keys of its group. */
  .key {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 1px solid var(--ink);
    background: var(--tint);
  }
</style>
