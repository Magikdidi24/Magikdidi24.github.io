---
/*
  The panel of the main screen: a desktop that covers the room, with an icon
  per project. An icon opens a window: a project as /projects/ shows it, a
  small program, a terminal, or the file that says who he is. Under them,
  what there is to find in the room: each icon is locked until its object
  has been found there, then it opens its panel; a list of things to do
  says how, and ticks off what is done (src/room/ui/panels.ts keeps both up
  to date, from src/room/ui/found.ts). Two projects can be played in their window,
  and five small programs have a window of their own: the program itself
  runs there (src/room/ui/demos). Icons are links to the id of what
  they open, so each window has its own address (src/room/ui/route.ts); the
  window of a project carries the id of that project, so that a page opened
  straight on it shows the window from its top. The
  terminal reads the site from the attributes of its shell: nothing is
  bundled twice.
*/
import ProjectEntry from '../projects/ProjectEntry.astro';
import Chess from './demos/Chess.astro';
import Fluid from './demos/Fluid.astro';
import Program from './demos/Program.astro';
import { projects, smallerProjects } from '../../data/projects';
import { desktop, finds, programs, stops, terminal, windowOf } from '../../data/room';
import { person } from '../../data/site';
import { PALETTE, type Swatch } from '../../room/voxel/palette';

const stop = stops.find(({ id }) => id === 'projects')!;
const tints: Swatch[] = ['cyan', 'magenta', 'amber', 'lime', 'violet', 'red'];
const tint = (i: number) => `--tint: ${PALETTE[tints[i % tints.length]]}`;
/* The small programs that run in a window of their own, each with what the site says of it. */
const playable = programs.flatMap(({ repo, file, keys, cell }) => {
  const item = smallerProjects.find(({ repoName }) => repoName === repo);
  return item ? [{ id: windowOf(repo), item, file, keys, cell }] : [];
});
const icons = [
  ...projects.map(({ slug, name }) => ({ id: slug, name })),
  ...playable.map(({ id, item }) => ({ id, name: item.name })),
  { id: 'terminal', name: 'Terminal' },
  { id: 'about', name: desktop.about },
];
---
<section class="panel samos" id={stop.id} aria-labelledby={`${stop.id}-title`} tabindex="-1" style={`--sun: ${PALETTE.magenta}; --note: ${PALETTE.mustard}`}>
  <header class="bar">
    <h2 id={`${stop.id}-title`}>{stop.label}</h2>
    <button type="button" data-close>Close</button>
  </header>

  <p class="system" aria-hidden="true">{desktop.name}</p>

  <div class="desk">
    <ul class="icons apps" role="list">
      {icons.map(({ id, name }, i) => (
        <li>
          <a class="icon" href={`#${id}`}>
            <span class="glyph" style={tint(i)} aria-hidden="true"></span>
            {name}
          </a>
        </li>
      ))}
    </ul>

    <details class="todo" open>
      <summary><span>{desktop.todo}</span><span class="count"></span></summary>
      <ul role="list">
        {finds.map(({ id, task }) => (
          <li>
            <label><input type="checkbox" data-task={id} disabled /><span>{task}</span></label>
          </li>
        ))}
      </ul>
    </details>

    <div class="places">
      <h3>{desktop.places}</h3>
      <!-- What a locked icon answers when it is asked for, for those who do not see it written under the icon. -->
      <p class="hint visually-hidden" role="status"></p>
      <ul class="icons" role="list">
        {finds.map(({ id, label, night, task }, i) => (
          /* What is a stop at night only is listed at night only (see [data-when] in src/pages/index.astro). */
          <li data-when={night ? 'night' : undefined}>
            {id === 'calendar' ? (
              <button type="button" class="icon" data-find={id} data-calendar>
                <span class="glyph" style={tint(i)} aria-hidden="true"></span>
                {label}
                <span class="how" aria-hidden="true">{task}</span>
              </button>
            ) : (
              /* The CV is a file to download; the rest are panels of the room. */
              <a class="icon" href={id === 'cv' ? (person.cv ?? undefined) : `#${id}`} download={id === 'cv'} data-find={id}>
                <span class="glyph" style={tint(i)} aria-hidden="true"></span>
                {label}
                <span class="how" aria-hidden="true">{task}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  {projects.map((project) => (
    <div class="window" id={project.slug} data-item={project.slug} data-name={project.name} tabindex="-1" hidden>
      <p class="title">
        <span>{project.repoName}</span>{' '}
        <a href={`#${stop.id}`}>Close<span class="visually-hidden">: {project.name}</span></a>
      </p>
      <div class="body">
        {project.slug === 'fluid-simulation' && <Fluid />}
        {project.slug === 'chess-board' && <Chess />}
        <ProjectEntry project={project} anchor={false} />
      </div>
    </div>
  ))}

  {playable.map(({ id, item, file, keys, cell }) => (
    <div class="window" id={id} data-item={id} data-name={item.name} tabindex="-1" hidden>
      <p class="title">
        <span>{item.repoName}</span>{' '}
        <a href={`#${stop.id}`}>Close<span class="visually-hidden">: {item.name}</span></a>
      </p>
      <div class="body">
        <Program item={item} file={file} keys={keys} cell={cell} />
      </div>
    </div>
  ))}

  <div class="window" data-item="about" id="about" tabindex="-1" hidden>
    <p class="title">
      <span>{desktop.about}</span>{' '}
      <a href={`#${stop.id}`}>Close<span class="visually-hidden">: {desktop.about}</span></a>
    </p>
    <div class="body file">
      <p>{person.intro}</p>
      <p>{person.focus}</p>
      <p><a href="/classic/#about">More about me in the text version</a></p>
      <p class="meta"><a href="/licenses.txt">Licenses of the software and fonts this site uses</a></p>
    </div>
  </div>

  <div class="window" data-item="terminal" id="terminal" tabindex="-1" hidden>
    <p class="title">
      <span>terminal</span>{' '}
      <a href={`#${stop.id}`}>Close<span class="visually-hidden">: terminal</span></a>
    </p>
    <div
      class="shell"
      data-about={JSON.stringify([person.intro, person.focus])}
      data-cv={person.cv ?? ''}
      data-email={person.email}
      data-words={JSON.stringify(terminal)}
    >
      <div class="log" role="log" aria-live="polite" aria-label="Terminal output">
        <p>{terminal.greeting}</p>
      </div>
      <form>
        <label for="command">$<span class="visually-hidden"> Command</span></label>
        <input id="command" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" />
      </form>
    </div>
  </div>
</section>

<style>
  /* The desktop itself is laid out with the other panels, in src/pages/index.astro: dark, in the pixel font of the room. Its windows are paper, in the type of the site. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  h2 {
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
  }

  .bar button,
  .title a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 2px solid currentColor;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  /* The wallpaper: a sun going down, as on the screen in the room, and the name of the system in a corner. */
  .system {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-4);
    opacity: 0.6;
  }

  .system::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2.5rem;
    width: 9rem;
    height: 4.5rem;
    border-radius: 9rem 9rem 0 0;
    background: repeating-linear-gradient(to bottom, var(--sun) 0 0.75rem, transparent 0.75rem 1rem);
  }

  /* The icons of the PC, then those of the room under them; beside both, on a wide screen, the list of things to do. */
  .desk {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64rem) {
    .desk {
      grid-template: 'apps todo' auto 'places todo' 1fr / minmax(0, 1fr) 19rem;
      align-items: start;
    }

    .apps {
      grid-area: apps;
    }

    .todo {
      grid-area: todo;
    }

    .places {
      grid-area: places;
    }
  }

  h3 {
    margin-bottom: var(--space-4);
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* A note stuck on the screen: what there is to do in the room, ticked off as it is done. On a narrow screen it comes first, folded: the script shuts it there. */
  .todo {
    order: -1;
    padding: var(--space-4);
    background: var(--note);
    color: var(--room-ink);
  }

  @media (min-width: 64rem) {
    .todo {
      order: 0;
    }
  }

  .todo summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 1.5rem;
    cursor: pointer;
  }

  .todo[open] summary {
    margin-bottom: var(--space-4);
  }

  .todo ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .todo label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    align-items: start;
  }

  .todo input {
    flex: none;
    width: 1rem;
    min-width: 0;
    height: 1rem;
    min-height: 0;
    margin: 0.1rem 0 0;
    padding: 0;
    border: 2px solid var(--room-ink);
    border-radius: 0;
    background: none;
    appearance: none;
  }

  .todo input:checked {
    background: var(--room-ink);
    box-shadow: inset 0 0 0 2px var(--note);
  }

  .todo input:checked + span {
    text-decoration: line-through;
    opacity: 0.6;
  }

  /* Locked: the icon of something that has not been found in the room yet. A padlock stands for its picture, and what to do to open it shows under its name once it has been asked for. */
  .icon[data-locked] {
    cursor: not-allowed;
  }

  .icon[data-locked]:not([data-asked]) {
    opacity: 0.6;
  }

  .how {
    display: none;
    color: var(--note);
  }

  .icon[data-locked][data-asked] .how {
    display: block;
  }

  .icon[data-locked] .glyph {
    position: relative;
    border-style: dashed;
    background: none;
    box-shadow: none;
  }

  .icon[data-locked] .glyph::before,
  .icon[data-locked] .glyph::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .icon[data-locked] .glyph::before {
    bottom: 0.3rem;
    width: 1.25rem;
    height: 0.875rem;
    background: var(--room-paper);
  }

  .icon[data-locked] .glyph::after {
    bottom: 1.175rem;
    width: 0.75rem;
    height: 0.5rem;
    border: 2px solid var(--room-paper);
    border-bottom: 0;
  }

  button.icon {
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .icons {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr)); /* wide enough for the longest word of a name */
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icon {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    color: inherit;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .glyph {
    width: 3rem;
    height: 2.5rem;
    border: 2px solid var(--room-paper);
    background: var(--tint);
    box-shadow: inset 0 -0.5rem 0 rgb(0 0 0 / 0.25);
  }

  .icon:hover .glyph,
  .icon:focus-visible .glyph {
    transform: translateY(-2px);
  }

  .window {
    position: absolute;
    inset: var(--space-4);
    display: flex;
    flex-direction: column;
    max-width: 68rem;
    margin-inline: auto;
    border: 2px solid var(--room-paper);
    background: var(--paper);
    color: var(--ink);
  }

  .window[hidden] {
    display: none;
  }

  .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
    background: var(--room-ink);
    color: var(--room-paper);
  }

  .body,
  .shell {
    position: relative; /* what is placed out of the flow inside scrolls with the rest */
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 var(--space-5) var(--space-5);
    font-family: var(--font);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  .file {
    padding-top: var(--space-5);
  }

  .file p + p {
    margin-top: var(--space-4);
  }

  /* The first project of a window needs no rule above it. */
  .body :global(.project) {
    border-top: 0;
  }

  /* What can be played comes first, set apart from what is said of the project. */
  .body :global(.demo) {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .shell {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    background: var(--room-ink);
    color: var(--room-paper);
    font-family: var(--mono);
    font-size: var(--text-sm);
  }

  .log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .log :global(p) {
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--room-paper);
    background: none;
    color: inherit;
    font: inherit;
  }

  @media (scripting: none) {
    .bar button,
    .title a,
    .icons,
    .todo,
    .places,
    .system,
    [data-item='terminal'],
    .body :global(.demo:not([data-demo='program'])) {
      display: none;
    }

    .window,
    .window[hidden] {
      position: static;
      display: block;
      margin-bottom: var(--space-6);
    }

  }
</style>
