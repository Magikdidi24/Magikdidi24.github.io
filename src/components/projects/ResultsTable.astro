---
/*
  A results table for a project: a label column, then one or more value
  columns, with the source file linked under it. Same style as the forecast
  table: ink header row over a strong rule, hairlines between rows, values
  right aligned.
*/
import type { ProjectFigure } from '../../data/projects';
import Digits from '../home/Digits.astro';

type Results = Extract<ProjectFigure, { kind: 'results' }>;

export interface Props {
  figure: Results;
}

const { figure } = Astro.props;
const [labelHead, ...valueHeads] = figure.head;
// The type cannot tie the lengths together, so a ragged table fails the build.
const ragged = figure.rows.find((row) => row.values.length !== valueHeads.length);
if (ragged) {
  throw new Error(`ResultsTable: "${ragged.label}" has ${ragged.values.length} values for ${valueHeads.length} value columns`);
}
---
<figure class="results">
  <div class="scroll">
    <table>
      <caption>{figure.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{labelHead}</th>
          {valueHeads.map((head) => <th scope="col" class="n">{head}</th>)}
        </tr>
      </thead>
      <tbody>
        {figure.rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {row.values.map((value) => <td class="n"><Digits text={value} /></td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>
    Data from <a href={figure.source.href}>{figure.source.label}</a> in the repository.
  </figcaption>
</figure>

<style>
  .results {
    display: grid;
    row-gap: var(--space-4);
  }

  /* A wide table scrolls inside the figure instead of widening the page. */
  .scroll {
    min-width: 0;
    overflow-x: auto;
    container-type: inline-size;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  /* The caption wraps to the visible width when the table scrolls. */
  caption {
    max-width: 100cqi;
    caption-side: top;
    padding-bottom: var(--space-3);
    color: var(--ink-3);
    text-align: left;
  }

  th,
  td {
    padding: var(--space-3) var(--space-5) var(--space-3) 0;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    padding-top: 0;
    padding-bottom: var(--space-2);
    font-weight: 500;
    border-bottom: 1px solid var(--rule-strong);
  }

  tbody th,
  tbody td {
    border-bottom: 1px solid var(--rule);
  }

  tbody th {
    font-weight: 400;
  }

  .n {
    text-align: right;
    white-space: nowrap;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  figcaption {
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* Long file names in the source link break instead of overflowing. */
  figcaption a {
    overflow-wrap: anywhere;
  }
</style>
