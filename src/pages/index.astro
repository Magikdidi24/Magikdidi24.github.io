---
/*
  Home page: the 3D room. The static HTML is the name, the link to the text
  version (/classic/) and a loading line; the room is drawn by src/room/, which
  is loaded after the first paint. Without WebGL the visitor is sent to the
  text version.
*/
import '@fontsource/silkscreen/latin-400.css';
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
import { PALETTE } from '../room/voxel/palette';

const title = 'Samuel Berthelot, AI engineering student in Tokyo';
const description = `${person.intro} ${person.focus}`;
if (description.length > 160) {
  throw new Error(`Home meta description is ${description.length} characters; keep it under 160.`);
}
const colors = `--room-ink: ${PALETTE.ink}; --room-paper: ${PALETTE.paper}; --room-red: ${PALETTE.red}`;
---
<Base title={title} description={description} bare>
  <div class="room" id="room" style={colors}>
    <canvas
      class="view"
      role="img"
      aria-label="A bedroom drawn in 3D pixel art. What it shows is also in the text version of this site."
    ></canvas>
    <header class="hud">
      <h1>{person.name}</h1>
      <div class="tools">
        <!-- Shown once the room is drawn: see the script below. -->
        <button type="button" id="turn" aria-pressed="false" hidden>Turn around</button>
        <button type="button" id="night" aria-pressed="false" hidden>Night</button>
        <a href="/classic/">Text version</a>
      </div>
    </header>
    <p class="loader" role="status">Loading the room</p>
    <noscript>
      <p class="fallback">This page is a 3D room and needs JavaScript. <a href="/classic/">Read the text version</a>.</p>
    </noscript>
    <!-- Opened by a click in the room (src/room/ui/sheets.ts): a picture shown large, and the calendar. -->
    <dialog class="sheet" id="zoom">
      <figure></figure>
      <form method="dialog"><button>Close</button></form>
    </dialog>
    <dialog class="sheet" id="calendar" aria-labelledby="calendar-year">
      <div class="bar">
        <button type="button" data-step="-1" aria-label="Previous year">&lt;</button>
        <p id="calendar-year" aria-live="polite"></p>
        <button type="button" data-step="1" aria-label="Next year">&gt;</button>
      </div>
      <div class="months"></div>
      <form method="dialog"><button>Close</button></form>
    </dialog>
  </div>
</Base>

<script>
  const root = document.getElementById('room') as HTMLElement;
  const canvas = root.querySelector('canvas') as HTMLCanvasElement;
  const loader = root.querySelector('.loader') as HTMLElement;
  const textVersion = (root.querySelector('.hud a') as HTMLAnchorElement).href;

  /* The post-processing chain needs WebGL2 and half-float render targets. */
  function supported(): boolean {
    const gl = document.createElement('canvas').getContext('webgl2');
    if (!gl) return false;
    const ok = !!(gl.getExtension('EXT_color_buffer_float') || gl.getExtension('EXT_color_buffer_half_float'));
    gl.getExtension('WEBGL_lose_context')?.loseContext();
    return ok;
  }

  const toTextVersion = () => location.replace(textVersion + location.hash);

  /* Day or night is the visitor's choice once made. Storage can be closed to the page: the choice is then for this visit only. */
  const CHOICE = 'room-night';
  const chosen = (): string | null => {
    try {
      return localStorage.getItem(CHOICE);
    } catch {
      return null;
    }
  };

  /** The two buttons of the room: the other side, and day or night. */
  function controls(app: import('../room/main.ts').RoomApp): void {
    const turn = root.querySelector('#turn') as HTMLButtonElement;
    const night = root.querySelector('#night') as HTMLButtonElement;
    const saved = chosen();
    if (saved) app.setNight(saved === '1');
    night.setAttribute('aria-pressed', String(app.room.night));
    night.onclick = () => {
      app.setNight(!app.room.night);
      night.setAttribute('aria-pressed', String(app.room.night));
      try {
        localStorage.setItem(CHOICE, app.room.night ? '1' : '0');
      } catch {
        /* Not remembered, then. */
      }
    };
    turn.onclick = () => {
      turn.setAttribute('aria-pressed', String(!app.rig.behind));
      app.turn();
    };
    turn.hidden = night.hidden = false;
  }

  if (!supported()) {
    toTextVersion();
  } else {
    /* After the first paint, so the name and the links show before three.js loads. */
    requestAnimationFrame(async () => {
      try {
        const { start } = await import('../room/main.ts');
        const app = await start(canvas, root);
        loader.hidden = true;
        controls(app);
      } catch (error) {
        if (import.meta.env.DEV) throw error;
        toTextVersion();
      }
    });
  }
</script>

<style>
  .room {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--room-ink);
    color: var(--room-paper);
    font-family: 'Silkscreen', var(--mono);
    font-size: 1rem; /* twice the 8px grid of the pixel font */
    line-height: 1;
  }

  /* Sized by the pixel pipeline: it can be wider than the room by less than
     one virtual pixel, so it must not shrink to fit. */
  .view {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
  }

  .hud {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3);
    pointer-events: none;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  h1,
  .hud a,
  .hud button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 0;
    background: var(--room-ink);
    color: inherit;
    font: inherit;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    pointer-events: auto;
  }

  .hud button {
    cursor: pointer;
  }

  .hud [hidden] {
    display: none;
  }

  /* A button that is on: the room seen from behind, the night. */
  .hud [aria-pressed='true'] {
    background: var(--room-paper);
    color: var(--room-ink);
  }

  /* A few words over an object of the room, put there by a click (src/room/interaction/reactions.ts). */
  .room :global(.bubble) {
    position: absolute;
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--room-ink);
    background: var(--room-paper);
    color: var(--room-ink);
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 0.5rem));
  }

  /* One centred line of text, kept as a plain block so a link stays inline. */
  .loader,
  .fallback {
    position: absolute;
    inset: 50% var(--space-5) auto;
    transform: translateY(-50%);
    text-align: center;
  }

  .fallback {
    font-family: var(--font);
    line-height: var(--leading-body);
  }

  :focus-visible {
    outline-color: var(--room-paper);
  }

  /* A sheet over the room. What a script puts in it is not in this template, hence :global. */
  .sheet {
    max-width: 96vw;
    max-height: 96vh;
    padding: var(--space-3);
    border: 2px solid var(--room-paper);
    background: var(--room-ink);
    color: var(--room-paper);
    font: inherit;
  }

  .sheet::backdrop {
    background: rgb(26 20 35 / 0.8);
  }

  /* A sheet pops out of what was clicked: it grows from that point of the room, which the script gives it, to the middle of the page. */
  @keyframes pop {
    from {
      opacity: 0.3;
      transform: translate(var(--from-x, 0), var(--from-y, 0)) scale(0.05) rotate(-12deg);
    }

    60% {
      opacity: 1;
    }
  }

  @keyframes dim {
    from {
      opacity: 0;
    }
  }

  @keyframes ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: pop 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.25);
    }

    .sheet[open]::backdrop {
      animation: dim 0.3s ease-out;
    }

    .room :global(.bubble) {
      animation: pop 0.2s steps(4);
    }

    /* The ring is drawn once the calendar is open. */
    .months :global(.marked path) {
      stroke-dashoffset: 100;
      animation: ring 0.6s 0.5s ease-out forwards;
    }
  }

  .sheet figure {
    margin: 0;
  }

  .sheet :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 72vh;
  }

  /* A canvas of the room, enlarged by a whole number: sized by the script. */
  .sheet :global(img.pixels) {
    max-width: none;
    max-height: none;
    image-rendering: pixelated;
  }

  .sheet form,
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .sheet form {
    justify-content: flex-end;
    margin-top: var(--space-3);
  }

  .bar {
    margin-bottom: var(--space-3);
  }

  .sheet button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 2px solid var(--room-paper);
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .months {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    width: min(88vw, 54rem);
  }

  .months :global(table) {
    width: 100%;
    border-collapse: collapse;
  }

  .months :global(caption) {
    padding-bottom: var(--space-2);
    text-align: left;
  }

  .months :global(th),
  .months :global(td) {
    width: calc(100% / 7);
    padding: 0.25rem 0;
    font-weight: 400;
    text-align: center;
  }

  .months :global(th) {
    opacity: 0.6;
  }

  .months :global([aria-current]) {
    outline: 2px solid var(--room-paper);
    outline-offset: -2px;
  }

  /* The day that is circled: a ring drawn by hand, in red marker, wider than its cell as a real one would be. */
  .months :global(.marked) {
    position: relative;
  }

  .months :global(.marked svg) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    max-width: none; /* the site keeps pictures inside their box */
    height: 2.75rem;
    overflow: visible;
    transform: translate(-50%, -50%);
  }

  .months :global(.marked path) {
    fill: none;
    stroke: var(--room-red);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100;
  }

  @media (scripting: none) {
    .view,
    .loader {
      display: none;
    }
  }
</style>
