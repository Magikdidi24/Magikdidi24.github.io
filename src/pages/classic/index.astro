---
/*
  Text version of the home page; the 3D room is at "/". Sections in order:
  hero with the photon figure, selected work, projects, about, contact. The
  gap between sections is set here once; the footer brings its own top margin.
*/
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import SelectedWork from '../../components/home/SelectedWork.astro';
import Projects from '../../components/home/Projects.astro';
import About from '../../components/home/About.astro';
import Contact from '../../components/home/Contact.astro';
import { person } from '../../data/site';

const title = `${person.name}, text version of the portfolio`;
const description = `Text version of ${person.name}'s portfolio: image reconstruction research, compiler work, open source contributions, projects and contact.`;
if (description.length > 160) {
  throw new Error(`Classic meta description is ${description.length} characters; keep it under 160.`);
}
---
<Base title={title} description={description}>
  <div class="home">
    <Hero />
    <SelectedWork />
    <Projects />
    <About />
    <Contact />
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    row-gap: var(--section-gap);
  }
</style>
